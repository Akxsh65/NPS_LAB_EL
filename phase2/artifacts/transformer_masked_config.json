{
  "model": "transformer_masked",
  "train_pt": "../phase1/artifacts/train_tensors.pt",
  "val_pt": "../phase1/artifacts/val_tensors.pt",
  "out_dir": "./artifacts/refine/architecture/run_masked_d160",
  "batch_size": 1024,
  "num_workers": 4,
  "pin_memory": true,
  "epochs": 80,
