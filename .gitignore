# ============================================================
# Root .gitignore for NPS_LAB_EL
# ============================================================

# ---- Large dataset/cache (not needed for presentation demo) ----
data/
**/data/
dataset_cache/
*.h5
*.hdf5
*.parquet
*.csv.gz
*.npz
*.npy

# ---- Artifact directories: ignore everything, then allowlist below ----
phase1/artifacts/*
phase2/artifacts/*
phase3/artifacts/*
phase4/results/*
phase4/predictions/

# Presentation + API — required binaries (commit these for teammates)
!phase1/artifacts/
!phase1/artifacts/test_tensors.pt
!phase1/artifacts/label_encoder.pkl
!phase1/artifacts/ipt_scaler.pkl

!phase2/artifacts/
!phase2/artifacts/transformer_production.pt
!phase2/artifacts/transformer_masked_config.json
!phase2/artifacts/cnn_bilstm_best.pt

# Optional: full Phase 1 tensors for retraining (large; uncomment to track)
# !phase1/artifacts/train_tensors.pt
# !phase1/artifacts/val_tensors.pt

# Other large model formats (not used by presentation)
*.ckpt
*.bin
*.safetensors
*.onnx

# Phase 2 adaptive training outputs (large)
phase2/artifacts/adaptive/

# ---- Experiment outputs/logs ----
logs/
**/logs/
runs/
outputs/
figures/
wandb/
.wandb/
tensorboard_logs/
tb_logs/
lightning_logs/
events.out.tfevents*

# ---- Python virtual env/build/cache ----
venv/
.venv/
env/
.env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
coverage.xml
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE/editor ----
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# ---- OS files ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Secrets / local env ----
.env
.env.local
.env.*.local
secrets.txt
api_keys.txt
