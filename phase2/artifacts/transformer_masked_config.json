  "amp_dtype": "bf16",
  "label_smoothing": 0.0,
  "max_grad_norm": 1.0,
  "monitor_metric": "val_acc",
  "seed": 42,
  "warmup_epochs": 3,
  "d_model": 160,
  "nhead": 8,
  "num_layers": 4,
  "ff_dim": 512,
  "dropout": 0.2
}